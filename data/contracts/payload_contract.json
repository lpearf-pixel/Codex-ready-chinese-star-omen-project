{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-ready.local/contracts/payload_contract_v1.json",
  "title": "Local-KB Unified ingest payload contract v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["kb_book_id", "book_title", "card_type", "evidence_level", "final_citable", "query_mode_hint"],
  "properties": {
    "kb_book_id": {"type": "string", "minLength": 1},
    "book_id": {"type": "string", "deprecated": true},
    "book_title": {"type": "string", "minLength": 1},
    "card_type": {
      "type": "string",
      "enum": ["fenjuan", "fulltext", "xingguan_card", "zhusu_card", "term_card", "extract_card", "topic_index", "chapter_summary", "nav", "prompt_asset", "qa_example"]
    },
    "evidence_level": {"type": "string", "enum": ["primary", "structured", "index", "prompt", "example", "candidate"]},
    "final_citable": {"type": "boolean"},
    "query_mode_hint": {"type": "string", "enum": ["knowledge", "evidence", "support"]},
    "aliases": {"type": "array", "items": {"type": "string"}},
    "variant_terms": {"type": "array", "items": {"type": "string"}},
    "normalized_terms": {"type": "array", "items": {"type": "string"}},
    "source_locator": {"type": "string"},
    "frontmatter": {"type": "object"}
  },
  "top_level_required_after_flatten": ["kb_book_id", "book_title", "card_type", "evidence_level", "final_citable", "query_mode_hint"],
  "frontmatter_only_allowed": ["aliases", "variant_terms", "normalized_terms", "source_locator"],
  "deprecated_fields": ["book_id"],
  "ingest_responsibility": "projection_and_flattening_only"
}
