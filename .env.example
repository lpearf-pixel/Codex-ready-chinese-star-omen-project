APP_CONFIG_PATH=config/config.yaml

APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=INFO
APP_TIMEZONE=Asia/Shanghai
APP_DEFAULT_LIMIT=8

KB_SEARCH_BASE_URL=http://127.0.0.1:8008
KB_SEARCH_API_PORT=8008
KB_SEARCH_API_KEY=your_kb_search_api_key
KB_SEARCH_DEFAULT_COLLECTION=local_kb_default
KB_SEARCH_TIMEOUT_SECONDS=20

KB_SOURCES_ROOT=./data/sources
KB_ENABLE_OBSIDIAN_SOURCE=true
KB_OBSIDIAN_ROOT=./data/obsidian
KB_OBSIDIAN_INGEST_SOURCE_LABEL=obsidian
KB_OBSIDIAN_SOURCE_ROOT_LABEL=kaiyuan_zhanjing

ASTRO_DEFAULT_EPOCH=J2000
ASTRO_DEFAULT_LON=116.4
ASTRO_DEFAULT_LAT=39.9
ASTRO_DEFAULT_LOCATION_NAME=Beijing
ASTRO_VISIBILITY_MIN_ALT_DEG=5

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=astro
POSTGRES_USER=astro
POSTGRES_PASSWORD=change_me

GIT_INTERNAL_BASE_URL=https://git.internal.example
GIT_INTERNAL_TOKEN=your_git_internal_token
