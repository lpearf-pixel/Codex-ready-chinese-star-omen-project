APP_CONFIG_PATH=config/config.yaml

APP_ENV=test
APP_DEBUG=true
APP_LOG_LEVEL=DEBUG
APP_TIMEZONE=UTC
APP_DEFAULT_LIMIT=3

KB_SEARCH_BASE_URL=http://127.0.0.1:18008
KB_SEARCH_API_PORT=18008
KB_SEARCH_API_KEY=test_key_placeholder
KB_SEARCH_DEFAULT_COLLECTION=test_collection
KB_SEARCH_TIMEOUT_SECONDS=5

KB_SOURCES_ROOT=./tests/fixtures/sources
KB_ENABLE_OBSIDIAN_SOURCE=true
KB_OBSIDIAN_ROOT=./tests/fixtures/obsidian
KB_OBSIDIAN_INGEST_SOURCE_LABEL=obsidian_test
KB_OBSIDIAN_SOURCE_ROOT_LABEL=kaiyuan_test

ASTRO_DEFAULT_EPOCH=J2000
ASTRO_DEFAULT_LON=116.4
ASTRO_DEFAULT_LAT=39.9
ASTRO_DEFAULT_LOCATION_NAME=Beijing
ASTRO_VISIBILITY_MIN_ALT_DEG=5
