{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Asterism",
  "type": "object",
  "required": [
    "id",
    "name_cn",
    "system_version",
    "region",
    "modern_identifications",
    "source_refs"
  ],
  "properties": {
    "id": { "type": "string" },
    "name_cn": { "type": "string" },
    "aliases": { "type": "array", "items": { "type": "string" } },
    "system_version": {
      "type": "string",
      "enum": ["pre_qin", "han", "jin", "tang", "song", "ming", "qing", "modern_reconstruction"]
    },
    "region": { "type": "string", "enum": ["san_yuan", "er_shi_ba_xiu", "other"] },
    "parent_region": { "type": "string" },
    "anchor_star": { "type": "string" },
    "modern_identifications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["star_name", "catalog"],
        "properties": {
          "star_name": { "type": "string" },
          "catalog": { "type": "string" },
          "catalog_id": { "type": ["string", "integer"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "notes": { "type": "string" }
        }
      }
    },
    "geometry_hint": {
      "type": "object",
      "properties": {
        "shape_type": { "type": "string", "enum": ["single_star", "line", "polygon", "cluster"] },
        "description": { "type": "string" }
      }
    },
    "source_refs": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "string" }
  }
}
